# Listener. Loopback is safe without a client key.
LONGCHAT_HOST=127.0.0.1
LONGCHAT_PORT=1235

# Main OpenAI-compatible model server.
LONGCHAT_UPSTREAM_BASE_URL=http://127.0.0.1:1234
# LONGCHAT_UPSTREAM_API_KEY=

# Required when HOST is not loopback. Generate a long random value.
# LONGCHAT_CLIENT_API_KEY=

# Loaded main-model limits.
LONGCHAT_CONTEXT_TOKENS=8192
LONGCHAT_MAX_OUTPUT_TOKENS=2048
LONGCHAT_RECENT_TOKENS=1600
LONGCHAT_SAFETY_TOKENS=384
# Optional: compact before the physical context limit for latency/cache tuning.
# LONGCHAT_COMPACTION_TRIGGER_TOKENS=3800

# Helper model. Leave blank to use the request's main model.
# LONGCHAT_SUMMARY_MODEL=qwen3.5-summary
LONGCHAT_SUMMARY_CONTEXT_TOKENS=8192
LONGCHAT_SUMMARY_TOKENS=400
LONGCHAT_SUMMARY_TEMPERATURE=0.2

# LM Studio/Qwen example: keep summarisation fast and non-thinking.
# LONGCHAT_SUMMARY_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Optional main-request enforcement and volatile client-prompt cleanup.
# LONGCHAT_REQUEST_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# LONGCHAT_DROP_TOOLS=true
# LONGCHAT_STRIP_SYSTEM_TIMESTAMP=true
# LONGCHAT_DROP_SYSTEM_SECTIONS=Tools
# LONGCHAT_SYSTEM_APPEND=Always reach a clear conclusion before the output limit.

# State: memory (private default), sqlite (persistent), or off.
LONGCHAT_STATE_MODE=memory
# LONGCHAT_STATE_PATH=~/.local/share/longchat-proxy/state.sqlite3

# Optional hardening and provider controls.
LONGCHAT_REQUEST_MAX_BYTES=16777216
LONGCHAT_RATE_LIMIT_RPM=0
# Comma-separated browser origins. Empty disables CORS.
# LONGCHAT_CORS_ORIGINS=http://localhost:3000
LONGCHAT_HIDE_SUMMARY_MODEL=true
LONGCHAT_ON_COMPACTION_ERROR=error
LONGCHAT_LOG_LEVEL=INFO
